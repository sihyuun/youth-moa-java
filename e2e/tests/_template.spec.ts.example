/**
 * Playwright spec 템플릿 — 신규 화면 작업 시 복사 후 수정.
 *
 * 사용 방법:
 *   1. `cp e2e/tests/_template.spec.ts.example e2e/tests/<screen>.spec.ts`
 *   2. <screen> 부분 모두 교체
 *   3. 시나리오 추가
 *   4. `npx playwright test <screen>.spec.ts --reporter=line`
 *
 * 권장 시나리오 패턴 (ym-qa 가 자동 추가하는 표준):
 *   - GET 페이지 200 OK + 핵심 마크업 노출
 *   - form 필드 입력 + submit → 검증 메시지·redirect 동작
 *   - 빈 상태 카피 노출
 *   - 인터랙션 (체크박스·드롭다운·alert 등)
 *   - 회귀 박제 (한 번 발견된 버그 spec 으로 남김)
 */
import { test, expect, Page } from '@playwright/test';

/** form 의 모든 visible *-field-error / alert-error 텍스트 수집. 다른 spec 에서 재사용 가능. */
async function collectErrors(page: Page, errorClass: string = 'signup-field-error'): Promise<string[]> {
    await page.waitForLoadState('domcontentloaded');
    await page.locator(`.${errorClass}`).first().waitFor({ state: 'attached', timeout: 5000 }).catch(() => {});
    return await page.locator(`.${errorClass}:visible, .alert-error:visible`).allInnerTexts();
}

test.beforeEach(async ({ page }) => {
    await page.goto('/<path>');  // TODO: 화면 경로
    await expect(page).toHaveTitle(/<title>/);  // TODO: title 부분 매치
});

test('<시나리오 1: 페이지 진입·핵심 마크업>', async ({ page }) => {
    // TODO: 페이지 핵심 요소 visible 검증
    await expect(page.locator('<셀렉터>')).toBeVisible();
});

